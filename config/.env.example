# Keep real values in the server's protected environment, never in this file.
HMS_QR_ENV=prod
HMS_QR_DATABASE_URL=postgresql+psycopg://SERVER_USER:SERVER_PASSWORD@127.0.0.1:5432/hms_qr
HMS_QR_STORAGE_ROOT=\\NAS-SERVER\hms-qr-files
HMS_QR_AUTH_SECRET=replace-with-a-long-random-server-secret
HMS_QR_BOOTSTRAP_ADMIN_USERNAME=admin
HMS_QR_BOOTSTRAP_ADMIN_PASSWORD=replace-with-an-initial-admin-password
# Leave false for any system accessible beyond the trusted internal LAN.
HMS_QR_ALLOW_EMPTY_PASSWORDS=false
